MAAS_API_KEY=
# Shared password for OpenClaw Control UI (gateway.auth.mode: password).
# Generate with: openssl rand -base64 24
OPENCLAW_GATEWAY_PASSWORD=
# MaaS model routed via OpenShell inference (launch-openclaw.sh → openshell inference set).
INFERENCE_MODEL=claude-sonnet-4-6
# MaaS OpenAI-compatible base URL (maas-direct provider + NeMo upstream backend).
MAAS_BASE_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
# Inference path at launch: direct (MaaS, demo minute 0) or guardrailed (NeMo → MaaS).
INFERENCE_BACKEND=direct
# NeMo Guardrails service (internal cluster DNS). Override URL entirely with NEMO_GUARDRAILS_URL.
NEMO_GUARDRAILS_SERVICE=nemo-guardrails
NEMO_GUARDRAILS_NAMESPACE=openshell
NEMO_GUARDRAILS_PORT=80
# NEMO_GUARDRAILS_URL=http://nemo-guardrails.openshell.svc.cluster.local:80/v1
# OpenShift OAuth credentials for Playwright MLflow UI tests (browser login).
# OCP_TEST_USERNAME=
# OCP_TEST_PASSWORD=
