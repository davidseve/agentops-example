MAAS_API_KEY=
# Shared password for OpenClaw Control UI (gateway.auth.mode: password).
# Generate with: openssl rand -base64 24
OPENCLAW_GATEWAY_PASSWORD=
# MaaS model routed via OpenShell inference (launch-openclaw.sh → openshell inference set).
INFERENCE_MODEL=claude-sonnet-4-6
# Optional MaaS OpenAI-compatible base URL (default in launch-openclaw.sh if unset).
# MAAS_BASE_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
# OpenShift OAuth credentials for Playwright MLflow UI tests (browser login).
# OCP_TEST_USERNAME=
# OCP_TEST_PASSWORD=
